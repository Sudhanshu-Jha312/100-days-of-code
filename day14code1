//Write a program to print the sum of the first n odd numbers.


#include <stdio.h>

int main() {
    int n, i, current_odd = 1, sum = 0;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        sum += current_odd;
        current_odd += 2;
    }

    printf("The sum of the first %d odd numbers is: %d\n", n, sum);

    return 0;
}
