//Find the digit that occurs the most times in an integer number.

#include <stdio.h>
#include <stdlib.h>

int main() {
    long long num;
    int counts[10] = {0};
    int max_digit = 0;
    int max_count = 0;

    if (scanf("%lld", &num) != 1) {
        return 1;
    }

    num = llabs(num);

    if (num == 0) {
        counts[0] = 1;
    } else {
        while (num > 0) {
            counts[num % 10]++;
            num /= 10;
        }
    }

    for (int i = 0; i < 10; i++) {
        if (counts[i] > max_count) {
            max_count = counts[i];
            max_digit = i;
        }
    }

    printf("%d\n", max_digit);

    return 0;
}
