//Write a program to find the HCF (GCD) of two numbers.

#include <stdio.h>

int find_gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % temp;
        a = temp;
    }
    return a;
}

int main() {
    int num1, num2, gcd;

    if (scanf("%d %d", &num1, &num2) != 2) {
        return 1;
    }

    gcd = find_gcd(num1, num2);

    printf("%d\n", gcd);

    return 0;
}
