/* Write a program to print the following pattern:
    5
   45
  345
 2345
12345 */

#include <stdio.h>

int main() {
    int i, j, n = 5;
    for(i = 1; i <= n; i++) {
        for(int s = 1; s <= n - i; s++) {
            printf(" ");
        }
        for(j = i; j <= n; j++) {
            printf("%d", j);
        }
        printf("\n");
    }
    return 0;
}
