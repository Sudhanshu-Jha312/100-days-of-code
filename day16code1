//Write a program to take a number as input and print its equivalent binary representation.

#include <stdio.h>

int main() {
    int num;
    int binary[32];
    int i = 0;

    printf("Enter an integer: ");
    if (scanf("%d", &num) != 1) {
        return 1;
    }

    if (num == 0) {
        printf("Binary representation: 0\n");
        return 0;
    }

    unsigned int temp = (num < 0) ? (unsigned int)num : (unsigned int)num;

    while (temp > 0) {
        binary[i] = temp % 2;
        temp = temp / 2;
        i++;
    }

    printf("Binary representation: ");
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");

    return 0;
}
