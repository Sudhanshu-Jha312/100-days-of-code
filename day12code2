/*Write a program to calculate electricity bill based on units consumed with these rates: 
First 100 units at ₹5/unit 
Next 100 units at ₹7/unit 
Next 100 units at ₹10/unit 
Above at ₹12/unit*/

#include <stdio.h>

int main() {
    float units, total_bill = 0;

    printf("Enter the total units consumed: ");
    if (scanf("%f", &units) != 1 || units < 0) {
        printf("Invalid input! Units consumed cannot be negative.\n");
        return 1; // Exit the program with an error code
    }

  
    if (units <= 100) {
        total_bill = units * 5;
    } 
    else if (units <= 200) {
        total_bill = (100 * 5) + ((units - 100) * 7);
    } 
    else if (units <= 300) {
        total_bill = (100 * 5) + (100 * 7) + ((units - 200) * 10);
    } 
    else {
        total_bill = (100 * 5) + (100 * 7) + (100 * 10) + ((units - 300) * 12);
    }

    printf("Total Electricity Bill: \u20B9%.2f\n", total_bill);

    return 0;
}
