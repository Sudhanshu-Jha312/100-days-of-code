//Write a program to find the roots of a quadratic equation and categorize them.

#include <stdio.h>
#include <math.h> // Required for sqrt() function

int main() {
    double a, b, c;
    double discriminant, root1, root2, realPart, imagPart;

    printf("Enter coefficients a, b, and c: ");
 
    if (scanf("%lf %lf %lf", &a, &b, &c) != 3) {
        printf("Invalid input. Please enter numbers.\n");
        return 1;
    }

  
    if (a == 0) {
        printf("Error: 'a' cannot be 0. This is a linear equation, not a quadratic equation.\n");
        return 1;
    }

 
    discriminant = (b * b) - (4 * a * c);

    printf("\n--- Result ---\n");
    printf("Discriminant (D) = %.2lf\n", discriminant);

    if (discriminant > 0) {
       
        printf("Category: Roots are Real and Distinct (Different).\n");
        root1 = (-b + sqrt(discriminant)) / (2 * a);
        root2 = (-b - sqrt(discriminant)) / (2 * a);
        printf("Root 1 = %.2lf\n", root1);
        printf("Root 2 = %.2lf\n", root2);
    } 
    else if (discriminant == 0) {
      
        printf("Category: Roots are Real and Equal.\n");
        root1 = root2 = -b / (2 * a);
        printf("Root 1 = Root 2 = %.2lf\n", root1);
    } 
    else {
        
        printf("Category: Roots are Complex and Imaginary.\n");
        realPart = -b / (2 * a);
      
        imagPart = sqrt(-discriminant) / (2 * a); 
        printf("Root 1 = %.2lf + %.2lfi\n", realPart, imagPart);
        printf("Root 2 = %.2lf - %.2lfi\n", realPart, imagPart);
    }

    return 0;
}
