//Write a program to find the 1’s complement of a binary number and print it.

#include <stdio.h>
#include <string.h>

int main() {
    char binary[100];
    char onesComplement[100];
    int i;

    printf("Enter a binary number: ");
    if (scanf("%99s", binary) != 1) {
        return 1;
    }

    int length = strlen(binary);

    for (i = 0; i < length; i++) {
        if (binary[i] == '1') {
            onesComplement[i] = '0';
        } else if (binary[i] == '0') {
            onesComplement[i] = '1';
        } else {
            printf("Error: Invalid binary digit detected.\n");
            return 1;
        }
    }
    onesComplement[length] = '\0';

    printf("1's complement: %s\n", onesComplement);

    return 0;
}
