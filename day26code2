/* Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

* */

#include <stdio.h>

int main() {
    int rows[] = {1, 0, 3, 0, 5, 0, 3, 0, 1};
    int total_lines = 9;

    for (int i = 0; i < total_lines; i++) {
        for (int j = 0; j < rows[i]; j++) {
            printf("*\n");
        }
        if (rows[i] == 0 || i == total_lines - 1) {
            printf("\n");
        }
    }

    return 0;
}
